# Públicas (frontend)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública da loja (SEO, sitemap, canonical, JSON-LD, Merchant Center)
# Ex.: https://www.batistacosmeticos.com.br — sem barra no final
# Também usada como base do callback_url do Pix (Veno)
NEXT_PUBLIC_SITE_URL=https://www.batistacosmeticos.com.br

# Secretas (apenas servidor — sem NEXT_PUBLIC)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Dev local: contorna falha de envio de e-mail de confirmação (NUNCA use em produção)
# SUPABASE_BYPASS_EMAIL_CONFIRM=true

# SEO Merchant (opcional — dias de devolução / separação)
# Alinhado à política: arrependimento 7 dias; processamento 1–2 dias úteis
SEO_RETURN_DAYS=7
SEO_HANDLING_DAYS_MAX=2

# Veno Payments — PIX
# Dashboard → Integrações → API Keys (veno_live_…)
# Só a API key é obrigatória. Webhook no painel é opcional: cada Pix envia
# callback_url automaticamente, e o checkout também confirma por polling.
VENO_API_KEY=veno_live_sua-chave
# Opcional (default: https://beta.venopayments.com)
# VENO_API_URL=https://beta.venopayments.com

# Resend — e-mails transacionais (pedido confirmado etc.)
# Domínio batistacosmeticos.com.br deve estar verificado no Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Batista Cosméticos <atendimento@batistacosmeticos.com.br>

# Cron de rastreio interno legado (Vercel Cron chama /api/cron/tracking)
# Em produção é obrigatório. Authorization: Bearer <CRON_SECRET>
CRON_SECRET=troque-por-um-segredo-longo

# Track7 — rastreio de pedidos (somente servidor)
# Painel Track7 → Integrações / API Keys (t7_…)
# Sem a key, o sync não roda e a consulta pode responder “rastreio indisponível”.
TRACK7_API_KEY=
# Opcional (default: https://track7.app/api/v1) — não use api.track7.com.br / api.track7.app
# TRACK7_API_URL=https://track7.app/api/v1
